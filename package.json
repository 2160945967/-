{
  "name": "shici",
  "version": "2.0.0",
  "description": "拾词 - 智能单词词典学习工具",
  "author": "拾词",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && chcp 65001 >nul && electron .",
    "electron:start": "npm run build && node scripts/copy-static.cjs && npm run electron:compile && chcp 65001 >nul && electron .",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "npm run build && node scripts/copy-static.cjs && npm run electron:compile && electron-builder --win --x64",
    "package:dir": "npm run build && node scripts/copy-static.cjs && npm run electron:compile && electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.shici.app",
    "productName": "拾词",
    "directories": {
      "output": "release-final4"
    },
    "extraResources": [
      "pronunciations/**/*",
      "stardict.db",
      "examples.db",
      "sherpa-onnx-sense-voice-zh-en-ja-ko-yue/**/*",
      "resemble.txt",
      "lemma.en.txt",
      "wordroot.txt"
    ],
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node",
      "node_modules/sherpa-onnx-win-x64/**/*.node",
      "node_modules/sherpa-onnx-win-x64/**/*.dll",
      "node_modules/7zip-bin/**/*"
    ],
    "files": [
      "electron-dist/**/*",
      "!electron-dist/**/*.map",
      "dist/**/*",
      "node_modules/**/*",
      "resemble.txt",
      "lemma.en.txt",
      "wordroot.txt",
      "wordbooks.json",
      "logo.ico",
      "package.json",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/docs/**/*",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/LICENSE*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "logo.ico",
      "artifactName": "拾词-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "拾词",
      "include": "build/uninstaller.nsh",
      "license": "",
      "artifactName": "拾词-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^11.0.0",
    "compromise": "^14.0.0",
    "csv-parse": "^7.0.0",
    "docx": "^8.0.0",
    "edge-tts": "^1.0.0",
    "express": "^4.18.0",
    "gsap": "^3.12.0",
    "install": "^0.13.0",
    "mammoth": "^1.6.0",
    "multer": "^2.1.1",
    "sherpa-onnx-node": "^1.13.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^3.0.1",
    "sass": "^1.69.0",
    "sharp": "^0.35.2",
    "svg-to-ico": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-win-x64": "^1.13.3"
  }
}
