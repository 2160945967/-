{
  "name": "shici",
  "version": "2.0.2",
  "description": "拾词 - 智能单词词典学习工具",
  "author": "拾词",
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && chcp 65001 >nul && electron .",
    "electron:start": "npm run build && npm run prepackage && npm run electron:compile && chcp 65001 >nul && electron .",
    "gen:icons": "node tools/gen-icons.cjs",
    "prepackage": "node -e \"require('fs').mkdirSync('electron-dist',{recursive:true});require('fs').writeFileSync('electron-dist/package.json',JSON.stringify({type:'commonjs'}))\"",
    "pack:online": "electron-builder --config electron-builder.online.yml",
    "pack:offline": "electron-builder --config electron-builder.offline.yml",
    "dist:win": "npm run build && npm run prepackage && npm run electron:compile && electron-builder --win --x64 --config electron-builder.online.yml",
    "dist:win:offline": "npm run build && npm run prepackage && npm run electron:compile && electron-builder --win --x64 --config electron-builder.offline.yml",
    "dist:dir": "npm run build && npm run prepackage && npm run electron:compile && electron-builder --win --x64 --dir --config electron-builder.online.yml"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "7zip-bin": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.0",
    "docx": "^8.0.0",
    "edge-tts": "^1.0.0",
    "express": "^4.18.0",
    "gsap": "^3.12.0",
    "mammoth": "^1.6.0",
    "multer": "^2.1.1",
    "sherpa-onnx-node": "^1.13.8",
    "ts-fsrs": "^5.4.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "happy-dom": "^20.14.5",
    "png-to-ico": "^3.0.1",
    "sass": "^1.69.0",
    "sharp": "^0.35.2",
    "svg-to-ico": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "sherpa-onnx-win-x64": "^1.13.8",
    "sherpa-onnx-darwin-x64": "^1.13.8",
    "sherpa-onnx-darwin-arm64": "^1.13.8",
    "sherpa-onnx-linux-x64": "^1.13.8",
    "sherpa-onnx-linux-arm64": "^1.13.8"
  }
}
